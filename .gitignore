# Dependencies. The page itself has none; worker/ installs wrangler via npm.
# package-lock.json is committed on purpose so deploys are reproducible.
node_modules/

# IDE / editor
.idea/
.vscode/
*.iml
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Cloudflare Worker (worker/): wrangler's local state and build output, and
# the local secrets file. .dev.vars.example is committed, .dev.vars is not.
.wrangler/
.dev.vars
worker/dist/

# Local / temporary
.nimbalyst/
*.log
.env
.env.*
